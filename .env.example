# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only, use sparingly

# Brevo (SMTP & API -> API keys)
BREVO_API_KEY=                  # server only
BREVO_FROM_EMAIL=               # must be a verified sender, e.g. orders@YOUR_DOMAIN
BREVO_FROM_NAME=VogueGarb       # optional; defaults to VogueGarb

# Public site URL (used to build auth redirect URLs)
NEXT_PUBLIC_SITE_URL=

# Admin allowlist: comma-separated Google addresses that may open /admin.
# Server only — never prefix with NEXT_PUBLIC_.
ADMIN_EMAILS=
